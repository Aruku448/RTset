# These vendored text files are hashed byte-for-byte by the atmosphere integrity gate.
# Windows checkout must preserve the reviewed LF bytes, not convert to CRLF.
/third_party/prime-atmosphere-26.3/**/*.slang text eol=lf
/third_party/prime-atmosphere-26.3/**/*.json text eol=lf
/third_party/prime-atmosphere-26.3/*.json text eol=lf

# Streamline runtime files (including the license) are verified byte-for-byte.
# Preserve official SDK headers and notices without checkout normalization.
/src/main/resources/rtest/natives/windows-x86_64/streamline/** -text
/third_party/streamline/** -text
