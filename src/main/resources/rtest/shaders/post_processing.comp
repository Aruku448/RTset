layout(binding = 9, rgba16f) uniform writeonly image2D displayImage;
#else
layout(binding = 9, rgba8) uniform writeonly image2D displayImage;
#endif
layout(binding = 11, rgba16f) uniform image2D dofImage;
layout(binding = 12, rgba16f) uniform image2D cocImage;
layout(binding = 13) uniform texture2D bloomScratch;
layout(binding = 14, rgba16f) uniform writeonly image2D bloomScratchLevel;
layout(binding = 10, std140) uniform Parameters {
