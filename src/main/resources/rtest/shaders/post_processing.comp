// Existing Prime display operator, reused for the selectable Prime mode.
// Prime licensing and permissions are preserved in
// third_party/PRIME-LICENSE*.txt.
const vec3 PRIME_NEUTRAL_WEIGHTS =
    vec3(0.2120053547549465, 0.3921825078090138, 0.3958121374360396);
const float PRIME_GAMUT_COMPRESSION = 0.04;
const float PRIME_COMPRESSION_START = 0.18;

vec3 rec2020ToBt709(vec3 color) {
  return vec3(dot(vec3(1.6604910, -0.5876411, -0.0728499), color),
              dot(vec3(-0.1245505, 1.1328999, -0.0083494), color),
              dot(vec3(-0.0181508, -0.1005789, 1.1187297), color));
}
vec3 toVirtualRgb(vec3 color) {
  float neutral = dot(color, PRIME_NEUTRAL_WEIGHTS);
  return mix(color, vec3(neutral), PRIME_GAMUT_COMPRESSION);
}
vec3 fromVirtualRgb(vec3 color) {
  float neutral = dot(color, PRIME_NEUTRAL_WEIGHTS);
  return (color - PRIME_GAMUT_COMPRESSION * vec3(neutral)) /
         (1.0 - PRIME_GAMUT_COMPRESSION);
}
float curveComponent(float value) {
  if (value <= PRIME_COMPRESSION_START)
    return value;
