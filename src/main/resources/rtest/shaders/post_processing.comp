                 t <= 19 ? 0 : clamp(.54320679 * log(t - 10) - 1.196254, 0, 1))
          : vec3(clamp(1.29293619 * pow(t - 60, -.13320476), 0, 1),
                 clamp(1.12989086 * pow(t - 60, -.07551485), 0, 1), 1);
