layout(binding = 2) uniform texture2D depth;
layout(binding = 3, rgba32f) uniform image2D history;
layout(binding = 4, rgba16f) uniform image2D opticsImage;
layout(binding = 5) uniform texture2D bloomTexture;
layout(binding = 6, rgba16f) uniform writeonly image2D bloomLevel;
layout(binding = 7, rgba16f) uniform image2D gradedImage;
layout(binding = 8) uniform sampler linearClamp;
