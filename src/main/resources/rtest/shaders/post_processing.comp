       ba = dof ? imageLoad(dofImage, ivec2(b.x, a.y)).rgb
                : imageLoad(opticsImage, ivec2(b.x, a.y)).rgb,
       ab = dof ? imageLoad(dofImage, ivec2(a.x, b.y)).rgb
                : imageLoad(opticsImage, ivec2(a.x, b.y)).rgb,
       bb = dof ? imageLoad(dofImage, b).rgb : imageLoad(opticsImage, b).rgb;
