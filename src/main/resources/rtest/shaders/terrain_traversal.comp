#version 460

// RTest terrain traversal ABI. This shader intentionally does not bind the ray-tracing pass.
// NodeMetadata and TLAS instances are independent SSBOs; a TLAS record is exactly 16 uints.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint INVALID_INDEX = 0xffffffffu;
const uint NODE_READY = 1u;
const uint NODE_RENDERABLE = 2u;
const uint NODE_HAS_BLAS = 4u;
const uint TERRAIN_INSTANCE_MASK = 0xffu;
const uint FACING_CULL_DISABLE = 1u;
const float DEPTH_EPSILON = 1.0e-4;
const uint MAX_PARENT_DEPTH = 64u;

struct NodeMetadata {
    // 0: vec4 bounds min xyz, LOD error in pixels
    vec4 boundsMinAndLodError;
    // 16: vec4 bounds max xyz, integer LOD in float bits
    vec4 boundsMaxAndLod;
    // 32: parent, first child, child mask, reserved
    uvec4 hierarchy;
    // 48: instance slot, material base, triangle count, flags
    uvec4 draw;
};

layout(set = 0, binding = 0, std430) readonly buffer NodeMetadataBuffer {
    NodeMetadata nodes[];
};

// Each uvec2 is one device address split into low/high 32-bit words.
layout(set = 0, binding = 1, std430) readonly buffer BlasAddressBuffer {
    uvec2 blasAddresses[];
};

layout(set = 0, binding = 2) uniform sampler2D hizDepth;

// forwardZ/reversedZ Hi-Z uses max/min reduction respectively. The sampler must be NEAREST.
layout(set = 0, binding = 3, std140) uniform TraversalParameters {
    mat4 viewProjection;
    vec4 cameraAndRenderDistance; // xyz camera position, w XZ render distance
    vec4 viewport;                 // x/y screen dimensions, z unused, w unused
    uvec4 config;                  // node count, instance capacity, depth convention, unused
    vec4 sceneOrigin;              // world-space origin used by TLAS-local BLAS vertices
    uvec4 dummyBlasAddress;        // low/high words in x/y; valid address for masked slots
} params;

// Fixed Vulkan VkAccelerationStructureInstanceKHR record, represented as raw words so the
// offsets cannot be changed by GLSL struct padding. Words 0..11 are a 3x4 row-major transform,
// word 12 is customIndex[23:0] | instanceMask[31:24], word 13 is SBT offset | flags, and
// words 14..15 are accelerationStructureReference.
layout(set = 0, binding = 4, std430) writeonly buffer TlasInstanceBuffer {
    uint instanceWords[];
};

struct ScreenRect {
    vec4 xy;
    vec2 depth;
    bool intersects;
};

vec3 boundsMin(NodeMetadata node) { return node.boundsMinAndLodError.xyz; }
vec3 boundsMax(NodeMetadata node) { return node.boundsMaxAndLod.xyz; }
uint nodeLod(NodeMetadata node) { return floatBitsToUint(node.boundsMaxAndLod.w); }

ScreenRect projectBounds(NodeMetadata node) {
    vec3 lo = boundsMin(node);
    vec3 hi = boundsMax(node);
    vec2 rectMin = vec2(1.0);
    vec2 rectMax = vec2(0.0);
    float depthNear = params.config.z == 0u ? 1.0 : 0.0;
    float depthFar = params.config.z == 0u ? 0.0 : 1.0;
    bool behindNearPlane = false;
    for (uint corner = 0u; corner < 8u; corner++) {
        vec3 point = vec3((corner & 1u) == 0u ? lo.x : hi.x,
                          (corner & 2u) == 0u ? lo.y : hi.y,
                          (corner & 4u) == 0u ? lo.z : hi.z);
        vec4 clip = params.viewProjection * vec4(point, 1.0);
        if (!(clip.w > 0.0) || isnan(clip.w) || isinf(clip.w)) {
            behindNearPlane = true;
            continue;
        }
        vec3 ndc = clip.xyz / clip.w;
        vec2 screen = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
        rectMin = min(rectMin, screen);
        rectMax = max(rectMax, screen);
        if (params.config.z == 0u) {
            depthNear = min(depthNear, ndc.z);
            depthFar = max(depthFar, ndc.z);
        } else {
            depthNear = max(depthNear, ndc.z);
            depthFar = min(depthFar, ndc.z);
        }
    }
    if (behindNearPlane) return ScreenRect(vec4(0.0, 0.0, 1.0, 1.0),
        params.config.z == 0u ? vec2(0.0, 1.0) : vec2(1.0, 0.0), true);
    bool intersects = rectMax.x >= 0.0 && rectMin.x <= 1.0
                   && rectMax.y >= 0.0 && rectMin.y <= 1.0
                   && depthFar >= 0.0 && depthNear <= 1.0;
    return ScreenRect(vec4(clamp(rectMin, vec2(0.0), vec2(1.0)),
                           clamp(rectMax, vec2(0.0), vec2(1.0))),
                      vec2(clamp(depthNear, 0.0, 1.0), clamp(depthFar, 0.0, 1.0)), intersects);
}

bool hizOccluded(ScreenRect rect) {
    if (!rect.intersects || rect.xy.z <= rect.xy.x || rect.xy.w <= rect.xy.y) return false;
    ivec2 baseSize = textureSize(hizDepth, 0);
    vec2 pixelSize = (rect.xy.zw - rect.xy.xy) * vec2(baseSize);
    float longest = max(pixelSize.x, pixelSize.y);
    int mip = int(clamp(ceil(log2(max(longest, 1.0))), 0.0,
                        float(textureQueryLevels(hizDepth) - 1)));
    ivec2 size = textureSize(hizDepth, mip);
    ivec2 lo = clamp(ivec2(floor(rect.xy.xy * vec2(size))), ivec2(0), size - 1);
    ivec2 hi = clamp(ivec2(ceil(rect.xy.zw * vec2(size)) - vec2(1.0)), ivec2(0), size - 1);
    float aggregate = params.config.z == 0u ? 0.0 : 1.0;
    // ceil(log2()) makes each side touch no more than two texels. Visit every touched texel;
    // omitting one would turn an occlusion rejection into a non-conservative false positive.
    for (int y = lo.y; y <= hi.y; y++) {
        for (int x = lo.x; x <= hi.x; x++) {
            float sampleDepth = texelFetch(hizDepth, ivec2(x, y), mip).r;
            if (isnan(sampleDepth) || isinf(sampleDepth)) return false;
            aggregate = params.config.z == 0u ? max(aggregate, sampleDepth)
                                               : min(aggregate, sampleDepth);
        }
    }
    return params.config.z == 0u
        ? aggregate < rect.depth.x - DEPTH_EPSILON
        : aggregate > rect.depth.x + DEPTH_EPSILON;
}

float distanceToBoundsXZ(NodeMetadata node) {
    vec3 lo = boundsMin(node);
    vec3 hi = boundsMax(node);
    float dx = params.cameraAndRenderDistance.x < lo.x ? lo.x - params.cameraAndRenderDistance.x
             : params.cameraAndRenderDistance.x > hi.x ? params.cameraAndRenderDistance.x - hi.x : 0.0;
    float dz = params.cameraAndRenderDistance.z < lo.z ? lo.z - params.cameraAndRenderDistance.z
             : params.cameraAndRenderDistance.z > hi.z ? params.cameraAndRenderDistance.z - hi.z : 0.0;
    return length(vec2(dx, dz));
}

bool nodeVisible(NodeMetadata node, ScreenRect rect) {
    return (node.draw.w & NODE_READY) != 0u
        && rect.intersects
        && distanceToBoundsXZ(node) <= params.cameraAndRenderDistance.w
        && !hizOccluded(rect);
}

bool completeChildren(NodeMetadata node) {
    if (node.hierarchy.y == INVALID_INDEX || node.hierarchy.z == 0u) return false;
    for (uint childBit = 0u; childBit < 8u; childBit++) {
        if ((node.hierarchy.z & (1u << childBit)) == 0u) continue;
        uint childIndex = node.hierarchy.y + childBit;
        if (childIndex >= params.config.x) return false;
        NodeMetadata child = nodes[childIndex];
        if ((child.draw.w & (NODE_READY | NODE_RENDERABLE)) != (NODE_READY | NODE_RENDERABLE)
            || child.draw.z == 0u) return false;
    }
    return true;
}

bool shouldDescend(uint nodeIndex, NodeMetadata node, ScreenRect rect) {
    float screenSize = max(rect.xy.z - rect.xy.x, rect.xy.w - rect.xy.y)
                     * max(params.viewport.x, params.viewport.y);
    return nodeVisible(node, rect) && completeChildren(node)
        && screenSize > node.boundsMinAndLodError.w;
}

bool pathAllows(uint nodeIndex) {
    uint ancestor = nodes[nodeIndex].hierarchy.x;
    for (uint depth = 0u; depth < MAX_PARENT_DEPTH && ancestor != INVALID_INDEX; depth++) {
        if (ancestor >= params.config.x) return false;
        NodeMetadata parent = nodes[ancestor];
        ScreenRect parentRect = projectBounds(parent);
        if (!shouldDescend(ancestor, parent, parentRect)) return false;
        ancestor = parent.hierarchy.x;
    }
    return ancestor == INVALID_INDEX;
}

void writeIdentity(uint base) {
    instanceWords[base + 0u] = floatBitsToUint(1.0);
    instanceWords[base + 1u] = 0u;
    instanceWords[base + 2u] = 0u;
    instanceWords[base + 3u] = floatBitsToUint(0.0);
    instanceWords[base + 4u] = 0u;
    instanceWords[base + 5u] = floatBitsToUint(1.0);
    instanceWords[base + 6u] = 0u;
    instanceWords[base + 7u] = 0u;
    instanceWords[base + 8u] = 0u;
    instanceWords[base + 9u] = 0u;
    instanceWords[base + 10u] = floatBitsToUint(1.0);
    instanceWords[base + 11u] = 0u;
}

void main() {
    uint nodeIndex = gl_GlobalInvocationID.x;
    if (nodeIndex >= params.config.x) return;
    NodeMetadata node = nodes[nodeIndex];
    uint slot = node.draw.x;
    if (slot >= params.config.y) return;
    uint outputBase = slot * 16u;
    writeIdentity(outputBase);
    instanceWords[outputBase + 12u] = 0u;
    instanceWords[outputBase + 13u] = FACING_CULL_DISABLE << 24u;
    instanceWords[outputBase + 14u] = params.dummyBlasAddress.x;
    instanceWords[outputBase + 15u] = params.dummyBlasAddress.y;

    ScreenRect rect = projectBounds(node);
    bool currentVisible = nodeVisible(node, rect);
    bool descend = shouldDescend(nodeIndex, node, rect);
    bool selected = currentVisible
        && (node.draw.w & (NODE_RENDERABLE | NODE_HAS_BLAS)) == (NODE_RENDERABLE | NODE_HAS_BLAS)
        && node.draw.z > 0u && !descend && pathAllows(nodeIndex);
    uvec2 address = selected ? blasAddresses[nodeIndex] : uvec2(0u);
    bool hasAddress = address.x != 0u || address.y != 0u;
    if (selected && hasAddress) {
        instanceWords[outputBase + 3u] = floatBitsToUint(node.boundsMinAndLodError.x - params.sceneOrigin.x);
        instanceWords[outputBase + 7u] = floatBitsToUint(node.boundsMinAndLodError.y - params.sceneOrigin.y);
        instanceWords[outputBase + 11u] = floatBitsToUint(node.boundsMinAndLodError.z - params.sceneOrigin.z);
        instanceWords[outputBase + 12u] = node.draw.y & 0x00ffffffu
            | (TERRAIN_INSTANCE_MASK << 24u);
        instanceWords[outputBase + 14u] = address.x;
        instanceWords[outputBase + 15u] = address.y;
    }
}
