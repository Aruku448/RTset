#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0, rgba16f) uniform readonly image2D sourceColor;
layout(binding=1, rg16f) uniform readonly image2D sourceMotion;
layout(binding=2, rgba16f) uniform readonly image2D material;
layout(binding=3, rgba16f) uniform readonly image2D specularMaterial;
layout(binding=4, rgba32f) uniform readonly image2D position;
layout(binding=5, rgba16f) uniform readonly image2D noisySpecular;
layout(binding=6, rgba16f) uniform writeonly image2D color;
layout(binding=7, rg16f) uniform writeonly image2D motion;
layout(binding=8, rgba16f) uniform writeonly image2D normalRoughness;
layout(binding=9, rgba16f) uniform writeonly image2D albedo;
layout(binding=10, rgba16f) uniform writeonly image2D specularAlbedo;
layout(binding=11, r32f) uniform writeonly image2D hitDistance;
layout(push_constant) uniform Push { uint rr; } pc;
// Input/output radiance and material albedo are linear Rec.2020 in RTest.
vec3 to709(vec3 c) {
    return vec3(dot(c,vec3(1.660491,-0.587641,-0.072850)),
                dot(c,vec3(-0.124550,1.132900,-0.008349)),
                dot(c,vec3(-0.018151,-0.100579,1.118730)));
}
// Integrated specular reflectance (Ray Tracing Gems ch.32 / NVIDIA RR guide 4.2.1).
// F0 alone omits roughness and grazing-angle behavior needed by reconstruction.
vec3 specularReflectance(vec3 f0, float roughness, float noV) {
    float a=roughness*roughness, v=clamp(abs(noV),0,1);
    vec4 x=vec4(1,v,v*v,v*v*v), y=vec4(1,a,a*a,a*a*a);
    vec2 m1=vec2(dot(vec2(0.99044,-1.28514),x.xy),dot(vec2(1.29678,-0.755907),x.xy));
    vec3 m2=vec3(dot(vec3(1,2.92338,59.4188),x.xyw),
                 dot(vec3(20.3225,-27.0302,222.592),x.xyw),dot(vec3(121.563,626.13,316.627),x.xyw));
    vec2 m3=vec2(dot(vec2(0.0365463,3.32707),x.xy),dot(vec2(9.0632,-9.04756),x.xy));
    vec3 m4=vec3(dot(vec3(1,3.59685,-1.36772),x.xzw),
                 dot(vec3(9.04401,-16.3174,9.22949),x.xzw),dot(vec3(5.56589,19.7886,-20.2123),x.xzw));
    float bias=dot(m1,y.xy)/max(dot(m2,y.xyw),1e-6);
    float scale=dot(m3,y.xy)/max(dot(m4,y.xyw),1e-6);
    bias*=clamp(f0.g*50,0,1);
    return clamp(f0*max(scale,0)+max(bias,0),0,1);
}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy), size=imageSize(sourceColor);
    if(any(greaterThanEqual(p,size))) return;
    imageStore(color,p,vec4(max(to709(imageLoad(sourceColor,p).rgb),vec3(0)),1));
    imageStore(motion,p,vec4(imageLoad(sourceMotion,p).xy*vec2(size),0,0));
    if(pc.rr==0u) return;
    vec4 mat=imageLoad(material,p), norm=imageLoad(specularMaterial,p);
    bool hit=mat.a>=0.0;
    vec3 n=hit && dot(norm.xyz,norm.xyz)>1e-10 ? normalize(norm.xyz) : vec3(0,0,1);
    vec2 mr=unpackHalf2x16(floatBitsToUint(imageLoad(position,p).w));
    vec3 diffuse=clamp(to709(mat.rgb),0,1);
    vec3 f0=mix(vec3(clamp(mr.y,0.04,1.0)),diffuse,clamp(mr.x,0,1));
    float roughness=hit?clamp(mat.a,0,1):1;
    vec3 worldPosition=imageLoad(position,p).xyz;
    float noV=dot(worldPosition,worldPosition)>1e-12?abs(dot(n,normalize(-worldPosition))):1;
    imageStore(normalRoughness,p,vec4(n,roughness));
    imageStore(albedo,p,vec4(hit?diffuse*(1-clamp(mr.x,0,1)):vec3(0),1));
    imageStore(specularAlbedo,p,vec4(hit?specularReflectance(f0,roughness,noV):vec3(0),1));
    // RayGen stores raw world-unit secondary distances; never feed NRD's normalized distance.
    imageStore(hitDistance,p,vec4(hit?max(imageLoad(noisySpecular,p).a,0):0));
}
