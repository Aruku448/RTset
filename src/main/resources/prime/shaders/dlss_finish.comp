#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0, rgba16f) uniform readonly image2D source;
layout(binding=1, rgba16f) uniform writeonly image2D destination;
layout(push_constant) uniform Push { uint unused; } pc;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,imageSize(destination)))) return;
    vec3 c=imageLoad(source,p).rgb;
    vec3 outColor=vec3(dot(c,vec3(0.627404,0.329283,0.043313)),
                       dot(c,vec3(0.069097,0.919540,0.011362)),
                       dot(c,vec3(0.016391,0.088013,0.895595)));
    imageStore(destination,p,vec4(max(outColor,vec3(0)),1));
}
