#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D outputColor;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D denoisedDiffuse;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D denoisedSpecular;
layout(set = 0, binding = 3, r32f) uniform readonly image2D viewZ;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D material;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D specularMaterial;
// Current-frame detail layer. Directly visible emission and camera-segment atmosphere bypass NRD;
// static surface lighting is carried by the diffuse/specular histories.
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D emission;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D directDiffuse;
// Prepared current-frame signals: demodulated YCoCg + normalized hit distance.
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D noisyDiffuse;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D noisySpecular;

layout(push_constant) uniform CompositeSettings {
    float strength;
    float denoisingRange;
} settings;

vec3 yCoCgToLinear(vec3 color) {
    float t = color.x - color.z;
    return max(vec3(t + color.y, color.x + color.z, t - color.y), vec3(0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(outputColor)))) {
        return;
    }
    vec4 rawValue = imageLoad(outputColor, pixel);
    vec3 raw = max(rawValue.rgb, vec3(0.0));
    float viewZValue = imageLoad(viewZ, pixel).r;
    // RayGen's environment path is not a surface signal. Do not let a surface history overwrite
    // it when a camera ray changes from geometry to sky (or the reverse).
    if (viewZValue >= 65503.0) {
        imageStore(outputColor, pixel, rawValue);
        return;
    }
    // REBLUR does not write output outside this range. Never consume stale/uninitialized history.
    // Match NRD v4.17.3's strict, NaN-safe IsInDenoisingRange predicate.
    if (!(viewZValue < settings.denoisingRange)) {
        imageStore(outputColor, pixel, rawValue);
        return;
    }
    vec4 diffuseMaterial = imageLoad(material, pixel);
    if (diffuseMaterial.a < 0.0) {
        imageStore(outputColor, pixel, rawValue);
        return;
    }
    // Signed current-frame entity visibility residual; baseline illumination stays denoisable.
    vec4 directSample = imageLoad(directDiffuse, pixel);
    vec3 dynamicShadowDelta = directSample.rgb;
    vec4 diffuseSample = imageLoad(noisyDiffuse, pixel);
    vec4 specularSample = imageLoad(noisySpecular, pixel);
    // An unsampled/invalid continuation may still have nonzero primary NEE. Do not invent a
    // camera-based hit distance or spread an unsupported history over this information. Keep
    // that lobe's current-frame signal; the other valid lobe remains independently filtered.
    vec3 diffuseSignal = diffuseSample.rgb;
    vec3 specularSignal = specularSample.rgb;
    if (diffuseSample.a > 0.0) {
        diffuseSignal = imageLoad(denoisedDiffuse, pixel).rgb;
    }
    if (specularSample.a > 0.0) {
        specularSignal = imageLoad(denoisedSpecular, pixel).rgb;
    }
    vec3 diffuse = yCoCgToLinear(diffuseSignal) * max(diffuseMaterial.rgb, vec3(0.02));
    vec3 specular = yCoCgToLinear(specularSignal)
        * max(imageLoad(specularMaterial, pixel).rgb, vec3(0.02));
    // Finite-sun and area-light sampling stay filtered. Only the signed entity visibility
    // difference bypasses history; it must retain negative RGB values until final composition.
    vec3 visibleEmission = max(imageLoad(emission, pixel).rgb, vec3(0.0));
    float strength = clamp(settings.strength, 0.0, 1.0);
    // outputColor is the complete current-frame path sample. Removing the unfiltered channel
    // gives an exact diffuse+specular fallback even when the NRD strength is zero.
    vec3 rawSurface = max(raw - visibleEmission - dynamicShadowDelta, vec3(0.0));
    vec3 filteredSurface = mix(rawSurface, diffuse + specular, strength);
    vec3 denoised = max(filteredSurface
        + visibleEmission + dynamicShadowDelta, vec3(0.0));
    imageStore(outputColor, pixel, vec4(denoised, 1.0));
}
